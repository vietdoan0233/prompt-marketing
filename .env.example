# Copy to .env (root, for docker compose) and/or api/.env (for running the API directly).
# No secrets belong in this file. Real provider credentials go in a secret store, never in git.

# --- PostgreSQL (docker compose) ---
POSTGRES_USER=mergero
POSTGRES_PASSWORD=mergero-local-only
POSTGRES_DB=mergero

# --- API ---
# Leave unset locally to use SQLite at api/mergero_dev.db.
# DATABASE_URL=postgresql+psycopg://mergero:mergero-local-only@localhost:5432/mergero
MIN_EMPLOYEES_DEFAULT=20
STALE_AFTER_DAYS=365
AGING_AFTER_DAYS=180
DEFAULT_RETENTION_DAYS=30
# Live official APIs + company-website crawling. Required for `python -m app.seed` (there is no synthetic seed).
LIVE_CONNECTORS_ENABLED=true
# Optional contact appended to the crawler User-Agent (use a team mailbox, not a personal address).
HTTP_CONTACT=
CRAWL_MAX_PAGES_PER_DOMAIN=6
CRAWL_WORKERS=6
# Registries that need (free) registration. Empty = those connectors fail closed.
ZEFIX_USERNAME=
ZEFIX_PASSWORD=
CVR_USERNAME=
CVR_PASSWORD=
CORS_ORIGINS=http://localhost:3000
DEFAULT_ACTOR=reviewer@mergero.local

# --- Web ---
API_URL=http://localhost:8000
